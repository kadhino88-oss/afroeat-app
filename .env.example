# Local Expo environment. Copy this file to .env; never commit .env files.
# Physical phone: replace the LAN address with the computer's IPv4 address.
# Android emulator: http://10.0.2.2:5000/api
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=http://192.168.1.121:5000/api
EXPO_PUBLIC_LOCAL_IP=192.168.1.121
EXPO_PUBLIC_API_PORT=5000

# Stripe publishable key only. Use a real pk_test_ key for local testing.
# Never put STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET in the mobile app.
EXPO_PUBLIC_STRIPE_KEY=pk_test_REPLACE_WITH_REAL_TEST_PUBLISHABLE_KEY

# Needed for Android map builds; restrict this key to the AFROEAT Android
# package name and signing certificate in Google Cloud Console.
ANDROID_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_ANDROID_MAPS_KEY
