# Développement : laisse EXPO_PUBLIC_API_URL vide pour utiliser la détection locale.
# Production : renseigne une URL publique HTTPS se terminant par /api.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_LOCAL_IP=
EXPO_PUBLIC_API_PORT=5000

# Clé publique Stripe uniquement : jamais de clé secrète dans l’application mobile.
EXPO_PUBLIC_STRIPE_KEY=pk_test_replace_me

# Wallets désactivés par défaut. N’activer qu’après vérification de la configuration marchand.
EXPO_PUBLIC_ENABLE_APPLE_PAY=false
EXPO_PUBLIC_APPLE_MERCHANT_IDENTIFIER=
EXPO_PUBLIC_ENABLE_GOOGLE_PAY=false

# Nécessaire pour les builds Android de production ; restreindre par package et certificat.
ANDROID_GOOGLE_MAPS_API_KEY=
