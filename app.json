{
  "expo": {
    "name": "Afroeat",
    "slug": "afroeat",
    "owner": "bk-entreprises-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "afroeat",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bkentreprise.afroeat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "fr",
          "en",
          "de",
          "es",
          "it",
          "zh"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#983903"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.bkentreprise.afroeat"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Afroeat utilise votre position pendant l’utilisation de l’application pour trouver les commerces africains proches, suivre la livraison de votre commande et, pour les livreurs, partager votre position pendant une course.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {}
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Afroeat accède aux photos que vous choisissez pour votre profil, votre logo, vos plats ou vos documents justificatifs.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#983903"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Stripe React Native : le « push provisioning » (cartes dans Google Wallet) n'est pas utilisé.\n-dontwarn com.stripe.android.pushProvisioning.**\n-dontwarn com.reactnativestripesdk.pushprovisioning.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2648096-d74c-4732-96e0-ce31af47e9f8"
      }
    },
    "locales": {
      "fr": "./store/locales/fr.json",
      "en": "./store/locales/en.json",
      "de": "./store/locales/de.json",
      "es": "./store/locales/es.json",
      "it": "./store/locales/it.json",
      "zh": "./store/locales/zh.json"
    }
  }
}
